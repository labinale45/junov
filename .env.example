# Site URL for canonical links, Open Graph, sitemap, and ads.txt
NEXT_PUBLIC_SITE_URL=https://rabinale.com.np

# Google AdSense Publisher ID (optional override; default is set in src/lib/adsense.ts)
 NEXT_PUBLIC_ADSENSE_ID=ca-pub-7623266987094406

# Set to "true" to reveal the tools section's AdSlot placeholders (ToolLayout's top/bottom
# banners). Left unset/false, AdSlot renders nothing — flip this on once real AdSense ad
# units are approved and ready to go live.
NEXT_PUBLIC_ADS_ENABLED=false

# Gemini API key for the /tools/code-explainer AI feature (server-only, never exposed to the client).
# Get a free key at https://aistudio.google.com/app/apikey — the Code Explainer route
# returns a friendly "not configured" error if this is left unset.
GEMINI_API_KEY=
